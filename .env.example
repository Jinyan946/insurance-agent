# Pick ONE provider. If no key is set, the app runs in offline "mock" mode
# (regex extraction + template replies) so the SOP can still be demoed end-to-end.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=            # any OpenAI-compatible endpoint

# LLM_PROVIDER=anthropic      # anthropic | openai | mock (default: auto-detect from keys)

# The fixture appeal deadlines are in March/April 2026. Pin the demo clock so
# "days remaining" is meaningful; remove to use the real date.
DEMO_TODAY=2026-03-05
